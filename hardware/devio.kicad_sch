	(text "No audio. The Waveshare board carries its own codec, speaker and mic,"
		(exclude_from_sim no)
		(at 101.6 863.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "11231aa5-6087-407f-ae9a-098b6255919f")
	)
	(text "WHAT IS MISSING RELATIVE TO THE BRICK, and why:"
		(exclude_from_sim no)
		(at 101.6 838.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "499708aa-ea8d-43a4-b81e-627c9ceec286")
	)
	(text "two sensor ports and two motors. The brick has three of these chips."
		(exclude_from_sim no)
		(at 101.6 853.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5cd555f4-735e-480c-8145-0e30b3aa6470")
	)
	(text "No per-port 5V load switch. IOPWR_P1/P2 and POWERM_A/B go straight to"
		(exclude_from_sim no)
		(at 101.6 878.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "604e09e0-7483-4362-be7c-0af7acf49492")
	)
	(text "exercised here. Fit TPS2044s before testing that behaviour."
		(exclude_from_sim no)
		(at 101.6 889 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8eca77fb-66a6-4716-a46e-c693de65452f")
	)
	(text "TP_IRQ are no-connected."
		(exclude_from_sim no)
		(at 101.6 904.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "93b7b5cd-2f40-496b-bedf-607309c7ed69")
	)
	(text "No touch panel. The display header carries the touch pins but TP_CS and"
		(exclude_from_sim no)
		(at 101.6 899.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9db9bcc4-fbd6-4baf-b596-65822d6c357d")
	)
	(text "+5V, so a port cannot be power-cycled and hot-plug recovery cannot be"
		(exclude_from_sim no)
		(at 101.6 883.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a3e06657-0c0f-4aa4-b88b-9fcdbaa5ca8c")
	)
	(text "The PCA9555 is full: 14 port signals plus display reset and backlight."
		(exclude_from_sim no)
		(at 101.6 914.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a5296bc5-d9b7-424c-9f6d-a733dd0ac22d")
	)
	(text "and the I2S pins never reach the 40-pin header anyway."
		(exclude_from_sim no)
		(at 101.6 868.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c1bc7796-df2d-4e3d-b7e4-0aa166fb12d2")
	)
