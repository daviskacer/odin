	(text "the footprint must both use it - an odd/even footprint here would move"
		(exclude_from_sim no)
		(at 76.2 335.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "24fd24d3-13ca-4097-9174-12e35bc0643b")
	)
	(text "also power the board over its USB-C while the carrier drives VSYS."
		(exclude_from_sim no)
		(at 76.2 269.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "32018c75-7fc0-4318-a4a3-df29d8703a1d")
	)
	(text "21-40 back up the right, pin 40 (VBUS) opposite pin 1. The symbol and"
		(exclude_from_sim no)
		(at 76.2 330.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3e587caf-1ae8-4791-9ba6-454c5cb41074")
	)
	(text "(GPIO9-13, GPIO53). Those peripherals stay with the dev board."
		(exclude_from_sim no)
		(at 76.2 360.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4a9e7527-0e96-4631-938d-bcbc84fb893e")
	)
	(text "Reverse-polarity P-FET. Gate to GND, so the body diode conducts"
		(exclude_from_sim no)
		(at 76.2 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4db90afd-2759-4a22-9d6f-c27e15900a26")
	)
	(text "DRV8876s directly and returns to the pack; the header ground carries"
		(exclude_from_sim no)
		(at 76.2 284.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5dfbcfb8-2032-4404-ae74-1504e9efaf4d")
	)
	(text "NOT ON THE HEADER, so not usable by the carrier: the ESP32-C6 SDIO"
		(exclude_from_sim no)
		(at 76.2 350.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "616ea7ba-8bad-47ca-a1e7-d978bf81a35a")
	)
	(text "link (GPIO14-19), the microSD (GPIO39-44) and the audio codec"
		(exclude_from_sim no)
		(at 76.2 355.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "643ac2eb-4037-4745-b1d6-170ccce2d008")
	)
	(text "until the FET enhances; wire the pack backwards and nothing turns on."
		(exclude_from_sim no)
		(at 76.2 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6918ee86-d94c-4eb2-bbbd-554b8bc1af92")
	)
	(text "MOTOR RETURN CURRENT DOES NOT GO THROUGH THE HEADER. +BATT feeds the"
		(exclude_from_sim no)
		(at 76.2 279.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7dd7a713-6dd1-4a97-b9d7-16d4d632f596")
	)
	(text "measurement on the carrier."
		(exclude_from_sim no)
		(at 76.2 294.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a8c42832-e155-43a8-b71b-5ee8d4491ae9")
	)
	(text "POWER DIRECTION. The carrier feeds the dev board, not the other way"
		(exclude_from_sim no)
		(at 76.2 254 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ac0633c9-8ba1-4e3e-b182-85320bdb8988")
	)
	(text "round. +5V goes into header pin 39 (VSYS) and the board regulates its"
		(exclude_from_sim no)
		(at 76.2 259.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "be762c17-8b00-4367-953d-9a47cd412def")
	)
	(text "19/20 and are left alone."
		(exclude_from_sim no)
		(at 76.2 314.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c0dc90d5-8ca3-4d87-a9fa-f036301f8e05")
	)
	(text "PIN NUMBERING IS COUNTER-CLOCKWISE, Pico-style: 1-20 down the left row,"
		(exclude_from_sim no)
		(at 76.2 325.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cc965b3a-3260-4a7c-be22-387a04c78200")
	)
	(text "every pin from 2 upward onto the wrong pad, and nothing would flag it."
		(exclude_from_sim no)
		(at 76.2 340.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cdf7df40-ed10-440e-8f39-f31397fb5dfd")
	)
	(text "GPIO BUDGET: 24 of the 25 usable header GPIO are allocated. GPIO52"
		(exclude_from_sim no)
		(at 76.2 304.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ce28a594-aa17-4377-a271-c467edc9ebc8")
	)
	(text "(header pin 1) is the only spare. GPIO24/25 appear as DM/DP on pins"
		(exclude_from_sim no)
		(at 76.2 309.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d18bd34b-5579-4c20-934b-45efc7de9784")
	)
	(text "logic reference only. Amps through it would corrupt every analog"
